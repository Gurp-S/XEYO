# Copy to .env and adjust for local dev (XEYO.bat reads this on startup).
# Secrets belong in the app Settings panel or here — never commit .env.

# Backend
# XEYO_PYTHON_ROOT=python
# XEYO_HTTP_HOST=127.0.0.1
# XEYO_HTTP_PORT=8000
# XEYO_FRONTEND_PORT=5173
# XEYO_CORS_ORIGIN=http://localhost:5173

# Optional: bind a default workspace for CLI / headless runs
# XEYO_CWD=D:\path\to\your\project

# 仅开发测试 / 评测用的 HTTP mock transport（默认关闭，不管理模型进程）：
# XEYO_ALLOW_LOCAL_MODEL=1
