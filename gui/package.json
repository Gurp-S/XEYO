{
  "name": "xeyo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:rewind": "playwright test -c playwright.fullstack-rewind.config.ts",
    "test:e2e:rewind:headed": "playwright test -c playwright.fullstack-rewind.config.ts --headed",
    "test:e2e:ui-audit": "playwright test -c playwright.ui-audit.config.ts",
    "test:e2e:ui-audit:headed": "playwright test -c playwright.ui-audit.config.ts --headed",
    "test:e2e:ui-audit-full": "playwright test -c playwright.ui-audit-full.config.ts",
    "test:e2e:ui-audit-full:headed": "playwright test -c playwright.ui-audit-full.config.ts --headed",
    "test:e2e:install": "playwright install chromium",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "icons:gen": "node scripts/gen-app-icon.mjs",
    "preview:workflow": "npx --yes tsx scripts/preview-tool-workflow.ts"
  },
  "dependencies": {
    "@preact/signals-core": "1.14.4",
    "@preact/signals-react": "3.12.0",
    "@streamdown/cjk": "^1.0.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/math": "^1.0.2",
    "@tanstack/react-virtual": "^3.14.10",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "clsx": "^2.1.1",
    "idb": "^8.0.2",
    "katex": "^0.18.4",
    "lucide-react": "^0.511.0",
    "mermaid": "^11.16.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-material-icon-theme": "^1.2.0",
    "react-router-dom": "^7.6.0",
    "react-syntax-highlighter": "^16.1.1",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "streamdown": "^2.6.0",
    "tailwind-merge": "^3.3.0",
    "unist-util-visit-parents": "^6.0.2",
    "use-sync-external-store": "1.6.0",
    "zustand": "^5.0.5"
