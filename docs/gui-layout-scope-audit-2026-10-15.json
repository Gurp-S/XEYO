  "proposals": [
    {
      "id": "P01",
      "priority": "高",
      "title": "工具工作区需要按任务分配空间",
      "finding": "终端、浏览器、地图沿用约 248px 的工具列；地址、标签和操作行明显拥挤。空文件区也持续占用对话空间。",
      "proposal": "文件列表保留侧栏；终端、浏览器、地图在窄窗口切换为主内容工具页或临时展开层，显式打开并记住用户宽度。",
      "acceptance": "720×480 下地址和主要操作可用；对话输入不会被遮挡；关闭工具能回到原会话和滚动位置。",
      "evidence": "tool-browser-720、tool-terminal-720、tool-map-720 截图；ReviewWorkbench.tsx；ReviewWorkspaceNav.tsx"
    },
    {
      "id": "P02",
      "priority": "高",
      "title": "账号设置缺少明确的协议选择",
      "finding": "新增时按地址关键词猜协议；编辑时保留旧 provider。把原 OpenAI 账号地址改为 Anthropic 地址，保存分支仍可能沿用 OpenAI 协议。此项为源码确认，未发送真实厂商请求。",
      "proposal": "账号表单分开供应商名称、API 协议、请求地址和模型列表；允许明确选择协议，地址识别仅用于初始建议。",
      "acceptance": "新建与编辑采用同一协议来源；官方地址和中转地址均可配置；原账号迁移不悄悄改变协议。",
      "evidence": "gui/src/components/SettingsModal.tsx:309,488"
    },
    {
      "id": "P03",
      "priority": "中",
      "title": "命令、工具调用和 Git 记录的范围混杂",
      "finding": "导航叫命令记录，页内叫历史命令；实际收集所有工具调用，搜索也以参数 JSON 出现在命令列表。另有更改、Git、提交记录多组相近入口。",
      "proposal": "把全部工具记录明确为调用记录，按工具筛选并展示摘要；终端命令历史留在终端；Git 状态与提交历史归于版本控制分组。",
      "acceptance": "搜索不再被称为命令；每种记录有一致名称、范围和空态说明；不删除现有数据和工具能力。",
      "evidence": "gui/src/components/review/ReviewWorkspaceNav.tsx:16; gui/src/components/WorkspaceToolPanel.tsx:30,60"
    },
    {
      "id": "P04",
      "priority": "中",
      "title": "扩展中心可查看启停，但缺少配置入口",
      "finding": "插件/MCP/技能可查看启停；空态要求用户修改配置文件或重启后端，GUI 内没有对应的添加配置流程。",
      "proposal": "明确本页是管理页，并提供添加/导入配置、校验反馈和作用范围选择；安装市场与自动下载另行定义范围。",
      "acceptance": "用户从空态能完成声明和校验；本机/工作区配置来源可见；不会把未读取状态当成关闭。",
      "evidence": "gui/src/components/PluginsPanel.tsx:732,769; extensions-MCP-720 截图"
    },
    {
      "id": "P05",
      "priority": "中",
      "title": "任务卡片需要统一滚动与固定操作区",
      "finding": "长计划、审批和提问在卡片内部与外层任务栈同时滚动。实测按钮滚动后可点击，未判定为功能失效，但初始状态不易发现操作。",
      "proposal": "统一卡片头、正文滚动区与底部操作区；批准/拒绝/提交始终可见，长 Goal 与队列保留已有草稿、冲突和顺序规则。",
      "acceptance": "长内容和多卡并存时主要操作可见；动画开关均可用；输入框保持可访问。",
      "evidence": "6 组计划/审批/提问边界检查，动画开关两种状态"
    },
    {
      "id": "P06",
      "priority": "中",
      "title": "设置可读性和术语层级需要统一",
      "finding": "模型、权限、回溯等页的辅助文字常为 10–12px，灰色层级多；部分说明混用 preset、Shadow Git、journal、字节等实现术语。",
      "proposal": "统一标题、正文、说明与控件间距；主要正文采用一致字号；技术细节放入可展开说明，存储大小用直观单位。",
      "acceptance": "720×480 下主要字段和操作容易辨认；深浅主题均可读；每项设置展示作用范围和生效方式。",
      "evidence": "settings-account-form-720、settings-perms-720、settings-rewind-720 截图"
    },
    {
      "id": "P07",
      "priority": "中",
      "title": "主导航与菜单的功能分组不一致",
      "finding": "文件菜单同时承载新对话、终端、远程、设置、沉浸和退出；诊断中的实验、采集等高级能力与日常页面并列。",
      "proposal": "应用菜单负责应用级操作；工作区工具集中在工具入口；诊断保留入口但区分常用排障与高级实验；远程设置提供状态与连接管理。",
      "acceptance": "同一功能只有一个清晰的主入口；快捷入口指向同一实现；高级功能仍可访问，不静默删减能力。",
      "evidence": "gui/src/components/FileMenu.tsx:87; gui/src/features/diagnostics/DiagnosticsPanel.tsx:54; RemoteSettingsHelp.tsx"
    }
